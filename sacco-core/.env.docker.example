# Copy to .env in the project root: cp .env.docker.example .env
APP_PORT=8080
APP_PORT_ALT=8088
APP_URL=http://149.102.129.28:8080

# Remote MySQL (DB_PORT is the MySQL port, not the web app port)
DB_HOST=149.102.129.28
DB_PORT=3306
DB_DATABASE=ulm
DB_USERNAME=ulm
DB_PASSWORD=ulm

# SACCO premium features (optional)
SACCO_MEMBER_NUMBER_PREFIX=M
SACCO_DEFAULT_APPRAISAL_METHOD=combined
SACCO_TWO_THIRD_RATIO=0.6667
SACCO_GUARANTOR_MIN_COVERAGE=0.3333
SACCO_TELLER_MAX_SINGLE=100000
SACCO_TELLER_MAX_DAILY_WITHDRAWAL=500000
SACCO_TELLER_MAX_CASH=1000000
SACCO_ATM_DAILY_LIMIT=50000
SACCO_SMS_TRANSACTION_ALERTS=true
SACCO_SALARY_ADVANCE_MAX_PERCENT=50
SACCO_MPESA_C2B_VALIDATION_URL=
SACCO_MPESA_C2B_CONFIRMATION_URL=
SACCO_MPESA_B2C_RESULT_URL=
SACCO_MPESA_B2C_TIMEOUT_URL=
SACCO_MPESA_B2C_DAILY_LIMIT=50000
SACCO_MPESA_B2C_MAX_SINGLE=70000
SACCO_MPESA_B2C_MIN_SINGLE=10
SACCO_PESALINK_API_URL=
SACCO_PESALINK_API_KEY=

# Member KYC / IPRS (NIDA)
SACCO_REQUIRE_KYC_FOR_TRANSACTIONS=true
SACCO_KYC_VALIDITY_DAYS=365
SACCO_NIDA_API_URL=
SACCO_NIDA_API_KEY=
SACCO_IPRS_API_URL=
SACCO_IPRS_API_KEY=

# SASRA compliance thresholds
SACCO_CORE_CAPITAL_MIN=10000000
SACCO_CAR_ASSETS_MIN=10
SACCO_CAR_DEPOSITS_MIN=8
SACCO_INST_CAPITAL_MIN=8
SACCO_LIQUIDITY_RATIO_MIN=15
SACCO_NON_EARNING_MAX=10
SACCO_EXTERNAL_BORROWING_MAX=25
SACCO_SINGLE_MEMBER_EXPOSURE_MAX=10
SACCO_COMPLIANCE_REMINDER_DAYS=7,14,30
SACCO_AML_LARGE_THRESHOLD=1000000
SACCO_AML_STRUCTURING_THRESHOLD=100000

# USSD Node service API key (must match ulm-ussd-service/.env)
USSD_API_KEY=change-me-to-a-secure-random-string
